{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ninox Public Fields Modules API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Modules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List all modules in a workspace",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/workspace/:workspaceId/modules",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves all modules available in a workspace"
        },
        {
          "info": {
            "name": "Create a module",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/workspace/:workspaceId/modules",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a new module in a workspace"
        },
        {
          "info": {
            "name": "Get a specific module",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/workspace/:workspaceId/modules/:moduleName",
            "params": [
              {
                "name": "moduleName",
                "value": "",
                "type": "path",
                "description": "Module name"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves detailed information about a specific module, including its tables"
        },
        {
          "info": {
            "name": "Update a module",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/v1/workspace/:workspaceId/modules/:moduleName",
            "params": [
              {
                "name": "moduleName",
                "value": "",
                "type": "path",
                "description": "Module name"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates an existing module in a workspace"
        },
        {
          "info": {
            "name": "Delete a module",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/workspace/:workspaceId/modules/:moduleName",
            "params": [
              {
                "name": "moduleName",
                "value": "",
                "type": "path",
                "description": "Module name"
              },
              {
                "name": "workspaceId",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a module in a workspace"
        }
      ]
    }
  ],
  "bundled": true
}